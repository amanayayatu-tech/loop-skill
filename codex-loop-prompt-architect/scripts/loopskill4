)


class PublicParser(argparse.ArgumentParser):
    def error(self, message):
        raise EntryError(
            "USER_INPUT_INVALID",
            "The command input is invalid.",
            "Run loopskill4 --help and provide one supported public action.",
        )


def default_root() -> Path:
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "LoopSkill" / "4"
    base = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
    return base / "loopskill" / "4"


def parser() -> PublicParser:
    result = PublicParser(prog="loopskill4")
    subcommands = result.add_subparsers(dest="action", required=True)
    inspect = subcommands.add_parser("intake")
    inspect.add_argument("goal_or_file")
    prepare = subcommands.add_parser("prepare")
    prepare.add_argument("goal_or_file")
    prepare.add_argument("--output", type=Path, required=True)
    confirm = subcommands.add_parser("confirm")
    confirm.add_argument("prepared_directory", type=Path)
    start = subcommands.add_parser("start")
    start.add_argument("goal_file_or_prepared_directory")
    start.add_argument("--root", type=Path, default=default_root())
    start.add_argument("--prepared-output", type=Path)
    start.add_argument("--diagnostics", action="store_true")
    listing = subcommands.add_parser("list")
    listing.add_argument("--root", type=Path, default=default_root())
    show = subcommands.add_parser("status")
    show.add_argument("--root", type=Path, default=default_root())
    show.add_argument("--loop")
    show.add_argument("--diagnostics", action="store_true")
    show.add_argument("--refresh", action="store_true")
    for run_action in ("run", "continue"):
        run = subcommands.add_parser(run_action)
        run.add_argument("--root", type=Path, default=default_root())
        run.add_argument("--loop")
        run.add_argument("--diagnostics", action="store_true")
    for lifecycle_action in ("pause", "resume", "stop"):
        lifecycle = subcommands.add_parser(lifecycle_action)
        lifecycle.add_argument("--root", type=Path, default=default_root())
        lifecycle.add_argument("--loop")
        if lifecycle_action != "resume":
            lifecycle.add_argument(
                "--reason", default="User requested lifecycle control."
            )
    approve = subcommands.add_parser("approve")
    approve.add_argument("--root", type=Path, default=default_root())
    approve.add_argument("--loop")
    approve.add_argument("--approval-digest", required=True)
    budget_extend = subcommands.add_parser("budget-extend")
    budget_extend.add_argument("--root", type=Path, default=default_root())
    budget_extend.add_argument("--loop")
    budget_extend.add_argument("--max-host-invocations", type=int, required=True)
    budget_extend.add_argument("--active-compute-seconds", type=int, required=True)
    budget_extend.add_argument("--reason", required=True)
    doctor = subcommands.add_parser("doctor")
    doctor.add_argument("--diagnostics", action="store_true")
    canary = subcommands.add_parser("canary")
    canary.add_argument("--candidate", required=True)
    canary.add_argument("--candidate-root", type=Path, required=True)
    canary.add_argument("--evidence-root", type=Path, required=True)
    canary.add_argument("--goals", type=int, choices=(1, 2, 8), default=1)
    canary.add_argument("--diagnostics", action="store_true")
    compile_prepared = subcommands.add_parser("compile")
    compile_prepared.add_argument("prepared_directory", type=Path)
    policy = subcommands.add_parser("policy")
    policy.add_argument("--root", type=Path, default=default_root())
    policy.add_argument("--loop")
    revise = subcommands.add_parser("roadmap-revise")
    revise.add_argument("objectives", nargs="+")
    revise.add_argument("--reason", required=True)
    revise.add_argument("--root", type=Path, default=default_root())
    revise.add_argument("--loop")
    steer = subcommands.add_parser("steer")
    steer.add_argument("choice", choices=("continue-repair", "wait", "stop"))
    steer.add_argument("--failure-fingerprint", default="")
    steer.add_argument("--root", type=Path, default=default_root())
    steer.add_argument("--loop")
    return result


_STORE_FILENAME = "loopskill-v4.sqlite3"
_LOOP_REF = re.compile(r"loop-[0-9a-zA-Z._-]{1,128}\Z")


def _discover_loops(base: Path) -> list[dict[str, object]]:
    """Rebuild the read-only discovery view from canonical per-Loop stores."""

    roots: list[Path] = []
    if (base / _STORE_FILENAME).is_file():
        roots.append(base)
    container = base / "loops"
    if container.is_dir() and not container.is_symlink():
        roots.extend(
            child
            for child in sorted(container.iterdir(), key=lambda item: item.name)
            if child.is_dir()
            and not child.is_symlink()
            and (child / _STORE_FILENAME).is_file()
        )
    discovered: list[dict[str, object]] = []
    seen: set[str] = set()
    try:
        for root in roots:
            with SQLiteStore(root / _STORE_FILENAME, readonly=True) as store:
                descriptors = store.loop_descriptors()
                if len(descriptors) != 1:
                    raise ValueError("store is not single-loop")
                descriptor = descriptors[0]
                loop_ref = str(descriptor["loop_ref"])
                if loop_ref in seen:
                    raise ValueError("duplicate loop identity")
                if root != base and root.name != loop_ref:
                    raise ValueError("loop directory identity mismatch")
                snapshot = store.snapshot(loop_ref)
                if snapshot is None:
                    raise ValueError("missing loop snapshot")
                seen.add(loop_ref)
                discovered.append(
                    {
                        "created_at": descriptor["created_at"],
                        "disposition": snapshot["execution"].get("disposition"),
                        "goal": descriptor["goal"],
                        "loop_ref": loop_ref,
                        "root": str(root),
                        "state": snapshot["execution"]["state"],
                    }
                )
    except (OSError, PersistenceError, ValueError) as exc:
        raise EntryError(
            "USER_STORE_UNAVAILABLE",
            "The Loop discovery view could not be rebuilt safely.",
            "Preserve the stores and inspect the selected data location.",
        ) from exc
    return sorted(discovered, key=lambda item: (str(item["created_at"]), str(item["loop_ref"])))


def _selected_loop_root(base: Path, loop_ref: str | None) -> Path:
    if loop_ref is not None and not _LOOP_REF.fullmatch(loop_ref):
        raise EntryError(
            "USER_INPUT_INVALID",
            "The Loop reference is invalid.",
            "Use an exact loop_ref shown by loopskill4 list.",
        )
    choices = _discover_loops(base)
    if loop_ref is not None:
        choices = [item for item in choices if item["loop_ref"] == loop_ref]
    # Preserve the v4.0/v4.1 direct-root lookup when no Store exists yet.  The
    # selected command remains responsible for reporting the missing Store;
    # discovery only becomes mandatory once more than one Loop is present or
    # the caller supplied an exact identity.
    if not choices and loop_ref is None:
        return base
    if len(choices) != 1:
        raise EntryError(
            "USER_STORE_UNAVAILABLE",
            "No unique Loop was selected.",
            "Run loopskill4 list and pass --loop with one exact loop_ref.",
        )
    return Path(str(choices[0]["root"]))


def _new_loop_root(base: Path, loop_ref: str) -> Path:
    if not _LOOP_REF.fullmatch(loop_ref):
        raise EntryError(
            "USER_PREPARATION_INVALID",
            "The prepared Loop reference is invalid.",
            "Prepare again in a new owner-only directory.",
        )
    return base / "loops" / loop_ref


_INTAKE_FIELDS = {
    "acceptance_criteria",
    "authorization_boundaries",
    "budget",
    "external_actions",
    "goal",
    "goal_plan",
    "stop_conditions",
    "task_horizon",
    "write_scope",
}
_SEQUENCE_FIELDS = {
    "acceptance_criteria",
    "authorization_boundaries",
    "external_actions",
    "goal_plan",
    "stop_conditions",
    "write_scope",
}


def _intake_value(
    document,
    *,
    source_kind="expert_semantic_json",
    source_raw: bytes | None = None,
) -> LoopIntakeInput:
    if not isinstance(document, dict) or not set(document) <= _INTAKE_FIELDS:
        raise EntryError(
            "USER_INPUT_INVALID",
            "The input file has unsupported fields.",
            "Use only the documented semantic intake fields.",
        )
    values = {
        "goal": "",
        "goal_plan": (),
        "task_horizon": "unspecified",
        "write_scope": (),
        "budget": "",
        "external_actions": (),
        "acceptance_criteria": (),
        "stop_conditions": (),
        "authorization_boundaries": (),
    }
    values.update(document)
    if not values["goal_plan"] and isinstance(values["goal"], str):
        values["goal_plan"] = (values["goal"],)
    if not isinstance(values["goal"], str) or not isinstance(values["task_horizon"], str) or not isinstance(values["budget"], str):
        raise EntryError(
            "USER_INPUT_INVALID",
            "The input file contains an invalid semantic value.",
            "Use UTF-8 strings and arrays of strings.",
        )
    for field in _SEQUENCE_FIELDS:
        value = values[field]
        if not isinstance(value, (list, tuple)) or not all(
            isinstance(item, str) for item in value
        ):
            raise EntryError(
                "USER_INPUT_INVALID",
                "The input file contains an invalid semantic list.",
                "Use arrays containing only UTF-8 strings.",
            )
        values[field] = tuple(value)
    raw = canonical_bytes(document) if source_raw is None else source_raw
    return LoopIntakeInput(
        **values,
        source_kind=source_kind,
        source_digest=raw_domain_digest("loopskill-prd-source-v1\n", raw),
        source_bytes=len(raw),
    )


def _canonical_plan_input(document, raw: bytes) -> LoopIntakeInput:
    try:
        plan = canonicalize_plan(document)
    except PlanCodecError as exc:
        raise EntryError(
            exc.code,
            "The canonical plan does not satisfy the closed v4.2 contract.",
            f"Repair the plan and try again ({exc.reason}).",
        ) from exc
    admitted_digest = raw_domain_digest("loopskill-prd-source-v1\n", raw)
    plan = canonicalize_plan(
        {
            **plan,
            "source": {
                **plan["source"],
                "kind": "canonical_plan_json",
                "source_digest": admitted_digest,
            },
        }
    )
    boundaries = plan["boundaries"]
    return LoopIntakeInput(
        goal=plan["objective"],
        goal_plan=tuple(goal["objective"] for goal in plan["goals"]),
        task_horizon=plan["roadmap_policy"]["mode"].lower(),
        write_scope=tuple(boundaries["write_scope"]),
        budget=canonical_bytes(plan["budget"]).decode("utf-8"),
        external_actions=tuple(boundaries["external_actions"]),
        acceptance_criteria=tuple(plan["completion_evidence"]),
        stop_conditions=tuple(plan["stop_conditions"]),
        authorization_boundaries=tuple(boundaries["forbidden_actions"]),
        canonical_plan=plan,
        source_kind="canonical_plan_json",
        source_digest=admitted_digest,
        source_bytes=len(raw),
    )


def _file_identity(metadata: os.stat_result) -> tuple[int, int, int, int, int, int]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_mode,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def _directory_identity(metadata: os.stat_result) -> tuple[int, int, int]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        stat.S_IFMT(metadata.st_mode),
    )


def _admission_components(path: Path) -> tuple[str, tuple[str, ...]]:
    if path.is_absolute():
        components = tuple(path.parts[1:])
        # Darwin exposes this one fixed compatibility anchor as
        # /var -> private/var.  Verify that exact system alias, then traverse
        # /private/var directly; never resolve or follow a user-controlled
        # component.
        if sys.platform == "darwin" and components[:1] == ("var",):
            try:
                alias = os.lstat("/var")
                alias_target = os.readlink("/var")
            except OSError:
                pass
            else:
                if (
                    stat.S_ISLNK(alias.st_mode)
                    and alias.st_uid == 0
                    and alias_target == "private/var"
                ):
                    components = ("private", "var", *components[1:])
        anchor = "/"
    else:
        components = tuple(path.parts)
        anchor = "."
    if (
        not components
        or any(component in {"", ".", ".."} for component in components)
        or not hasattr(os, "O_DIRECTORY")
        or not hasattr(os, "O_NOFOLLOW")
    ):
        raise OSError("invalid source path")
    return anchor, components


def _admit_source(
    path: Path,
    *,
    maximum: int | None,
) -> tuple[str, bytes | tuple[str, ...] | None] | None:
    descriptors: list[int] = []
    mappings: list[tuple[int, str, tuple[int, int, int]]] = []
    leaf_observed = False
    flags_directory = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    flags_file = os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0)
    try:
        anchor, components = _admission_components(path)
        directory_fd = os.open(anchor, flags_directory)
        descriptors.append(directory_fd)
        for component in components[:-1]:
            child_fd = os.open(component, flags_directory, dir_fd=directory_fd)
            mappings.append(
                (directory_fd, component, _directory_identity(os.fstat(child_fd)))
            )
            descriptors.append(child_fd)
            directory_fd = child_fd

        leaf = components[-1]
        descriptor = os.open(leaf, flags_file, dir_fd=directory_fd)
        descriptors.append(descriptor)
        leaf_observed = True
        opened = os.fstat(descriptor)

        limit_exceeded = False
        if stat.S_ISDIR(opened.st_mode):
            directory_identity = _directory_identity(opened)
            entries = tuple(sorted(os.listdir(descriptor)))
            after = os.fstat(descriptor)
            if _directory_identity(after) != directory_identity:
                raise OSError("source directory changed while inspecting")
            mappings.append((directory_fd, leaf, directory_identity))
            result: tuple[str, bytes | tuple[str, ...] | None] = (
                "directory",
                entries,
            )
        elif not stat.S_ISREG(opened.st_mode):
            current = os.stat(leaf, dir_fd=directory_fd, follow_symlinks=False)
            if _file_identity(current) != _file_identity(opened):
                raise OSError("source identity changed")
            result = ("other", None)
        elif maximum is None:
            current = os.stat(leaf, dir_fd=directory_fd, follow_symlinks=False)
            if _file_identity(current) != _file_identity(opened):
                raise OSError("source identity changed")
            result = ("file", None)
        else:
            opened_identity = _file_identity(opened)
            limit_exceeded = opened.st_size > maximum
            reads: list[bytes] = []
            observations: list[os.stat_result] = []
            if not limit_exceeded:
                for pass_index in range(2):
                    if pass_index:
                        os.lseek(descriptor, 0, os.SEEK_SET)
                    chunks = []
                    remaining = maximum + 1
                    while remaining:
                        chunk = os.read(descriptor, min(65_536, remaining))
                        if not chunk:
                            break
                        chunks.append(chunk)
                        remaining -= len(chunk)
                    reads.append(b"".join(chunks))
                    observations.append(os.fstat(descriptor))
                if (
                    any(
                        _file_identity(observation) != opened_identity
                        for observation in observations
                    )
                    or reads[0] != reads[1]
                ):
                    raise OSError("source changed while reading")
                raw = reads[0]
            else:
                raw = b""
            current = os.stat(leaf, dir_fd=directory_fd, follow_symlinks=False)
            if _file_identity(current) != opened_identity:
                raise OSError("source mapping changed while reading")
            limit_exceeded = limit_exceeded or len(raw) > maximum
            result = ("file", raw)

        for parent_fd, component, expected in mappings:
            current = os.stat(component, dir_fd=parent_fd, follow_symlinks=False)
            if (
                stat.S_ISLNK(current.st_mode)
                or _directory_identity(current) != expected
            ):
                raise OSError("source path component changed")
        if limit_exceeded:
            raise EntryError(
                "RESOURCE_LIMIT_EXCEEDED",
                "The input file exceeds the supported byte boundary.",
                f"Reduce the input to at most {maximum} UTF-8 bytes.",
            )
        return result
    except FileNotFoundError as exc:
        if not leaf_observed:
            return None
        raise EntryError(
            "PATH_CONFINEMENT_VIOLATION",
            "The requested source is unavailable, unsafe, or changed while reading.",
            "Provide one stable regular UTF-8 file without symlinks.",
        ) from exc
    except EntryError:
        raise
    except OSError as exc:
        raise EntryError(
            "PATH_CONFINEMENT_VIOLATION",
            "The requested source is unavailable, unsafe, or changed while reading.",
            "Provide one stable regular UTF-8 file without symlinks.",
        ) from exc
    finally:
        for descriptor in reversed(descriptors):
            try:
                os.close(descriptor)
            except OSError:
                pass


def _source_maximum(path: Path) -> int | None:
    suffix = path.suffix.lower()
    return (
        int(
            CAPACITY_CONTRACT[
                "expert_json_max_bytes"
                if suffix == ".json"
                else "source_text_max_bytes"
            ]
        )
        if suffix in {".json", ".md", ".txt"}
        else None
    )


def _decode_admitted_input(
    value: str,
    path: Path,
    maximum: int | None,
    admitted: tuple[str, bytes | tuple[str, ...] | None] | None,
) -> LoopIntakeInput:
    if admitted is not None:
        path_kind, payload = admitted
        if path_kind == "directory" and is_legacy_input(
            path,
            path_kind="directory",
            directory_entries=payload,
        ):
            raise EntryError(*unsupported_legacy_error())
        if path_kind != "file":
            raise EntryError(
                "USER_INPUT_INVALID",
                "The source is not a regular file.",
                "Provide one regular UTF-8 JSON, text, or Markdown file.",
            )
        if maximum is None:
            raise EntryError(
                "USER_INPUT_INVALID",
                "The source type is unsupported.",
                "Use one UTF-8 JSON, text, or Markdown file.",
            )
        if not isinstance(payload, bytes):
            raise EntryError(
                "PATH_CONFINEMENT_VIOLATION",
                "The requested source could not be read safely.",
                "Provide one stable regular UTF-8 file without symlinks.",
            )
        raw = payload
        if is_legacy_input(path, raw, path_kind="file"):
            raise EntryError(*unsupported_legacy_error())
        if path.suffix.lower() == ".json":
            return _decode_intake_bytes(raw, json_document=True)
        return _intake_value(
            {"goal": _decode_text(raw)},
            source_kind="authorized_file",
            source_raw=raw,
        )
    if value.startswith(("./", "../", "/")):
        raise EntryError(
            "USER_INPUT_INVALID",
            "The goal file was not found.",
            "Provide one readable goal file or literal goal text.",
        )
    raw = value.encode("utf-8", "strict")
    if b"\x00" in raw or len(raw) > int(CAPACITY_CONTRACT["source_text_max_bytes"]):
        raise EntryError(
            "RESOURCE_LIMIT_EXCEEDED",
            "The literal request exceeds the supported text boundary.",
            "Reduce the request or provide one smaller authorized file.",
        )
    return _intake_value(
        {"goal": value}, source_kind="literal_text", source_raw=raw
    )


def read_intake_input(value: str) -> LoopIntakeInput:
    if value == "-":
        raw = sys.stdin.buffer.read(int(CAPACITY_CONTRACT["expert_json_max_bytes"]) + 1)
        return _decode_intake_bytes(raw, json_document=True)
    path = Path(value)
    maximum = _source_maximum(path)
    admitted = _admit_source(path, maximum=maximum)
    return _decode_admitted_input(value, path, maximum, admitted)


def _decode_intake_bytes(raw: bytes, *, json_document: bool) -> LoopIntakeInput:
    maximum = int(
        CAPACITY_CONTRACT[
            "expert_json_max_bytes" if json_document else "source_text_max_bytes"
        ]
    )
    if len(raw) > maximum:
        raise EntryError(
            "RESOURCE_LIMIT_EXCEEDED",
            "The input is too large.",
            f"Reduce the input to at most {maximum} UTF-8 bytes.",
        )
    text = _decode_text(raw)
    if not json_document:
        return _intake_value(
            {"goal": text}, source_kind="pasted_text", source_raw=raw
        )
    try:
        document = parse_json_bytes(raw)
    except Exception as exc:
        raise EntryError(
            "USER_INPUT_INVALID",
            "The input file is not valid UTF-8 JSON.",
            "Use one JSON object containing documented semantic intake fields.",
        ) from exc
    if isinstance(document, dict) and document.get("schema") in {
        "loopskill-plan-v1",
        "loopskill-plan-v2",
    }:
        return _canonical_plan_input(document, raw)
    return _intake_value(document, source_raw=raw)


def _decode_text(raw: bytes) -> str:
    try:
        text = raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise EntryError(
            "USER_INPUT_INVALID",
            "The goal file is not valid UTF-8.",
            "Save the file as UTF-8 and try again.",
        ) from exc
    if "\x00" in text:
        raise EntryError(
            "USER_INPUT_INVALID",
            "The source contains a NUL byte.",
            "Provide plain UTF-8 text without embedded NUL bytes.",
        )
    return text


def print_status(value) -> None:
    print("LoopSkill 4")
    print("Goal: " + json.dumps(value.goal, ensure_ascii=False))
    print(f"Progress: {value.progress}")
    print(f"Result: {value.result}")
    if value.limitations:
        print("Limitations: " + " ".join(value.limitations))
    else:
        print("Limitations: None")
    if value.next_actions:
        print("Next action: " + " ".join(value.next_actions))
    else:
        print("Next action: None")


def print_intake_report(report) -> None:
    for section, value in report.items():
        print(section)
        print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def print_boundary(context) -> None:
    print("LoopSkill 4 start boundary")
    for label, value in boundary_display(context).items():
        print(f"{label}: " + json.dumps(value, ensure_ascii=False))


def _doctor_view(*, include_diagnostics: bool):
    # This explicit operability command loads the optional projection lazily;
    # the minimal intake/prepare/start path never imports it.
    from loop_architect.v4_operability import doctor_projection

    skill_root = Path(__file__).resolve().parents[1]
    generated = skill_root / "scripts/loop_architect/v4_alpha/generated_protocol.py"
    source_identity = hashlib.sha256(generated.read_bytes()).hexdigest()
    capabilities = {
        "host_lifecycle": "UNVERIFIABLE",
        "memory": "UNVERIFIABLE",
        "python_runtime": "AVAILABLE",
    }
    installed_identity = None
    codex_home = os.environ.get("CODEX_HOME")
    if codex_home:
        receipt_root = Path(codex_home) / "install-receipts/loopskill4"
        pointer = receipt_root / "active-receipt"
        if receipt_root.is_dir() and pointer.is_file() and not pointer.is_symlink():
            try:
                active = json.loads(pointer.read_text(encoding="utf-8"))
                if not isinstance(active, dict) or set(active) != {"receipt", "sha256"}:
                    raise ValueError("invalid active receipt pointer")
                receipt_name = active["receipt"]
                if (
                    not isinstance(receipt_name, str)
                    or Path(receipt_name).name != receipt_name
                    or not receipt_name.endswith(".json")
                ):
                    raise ValueError("invalid active receipt name")
                receipt_path = receipt_root / receipt_name
                receipt_raw = receipt_path.read_bytes()
                if (
                    receipt_path.is_symlink()
                    or hashlib.sha256(receipt_raw).hexdigest() != active["sha256"]
                ):
                    raise ValueError("active receipt drift")
                receipt = json.loads(receipt_raw.decode("utf-8", "strict"))
                expected = receipt["files"]
                current = []
                for path in sorted(skill_root.rglob("*")):
                    relative = path.relative_to(skill_root)
                    if (
                        "__pycache__" in relative.parts
                        or path.suffix == ".pyc"
                        or path.name == ".DS_Store"
                    ):
                        continue
                    if path.is_symlink():
                        raise ValueError("installed symlink")
                    if path.is_file():
                        current.append(
                            {
                                "path": relative.as_posix(),
                                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
                                "executable": bool(path.stat().st_mode & 0o111),
                            }
                        )
                if current == expected and receipt.get("source_install_drift") == []:
                    installed_identity = source_identity
                    capabilities["install_receipt"] = "AVAILABLE"
                else:
                    installed_identity = "DRIFT"
                    capabilities["install_receipt"] = "AVAILABLE"
            except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
                installed_identity = "DRIFT"
                capabilities["install_receipt"] = "UNVERIFIABLE"
        else:
            capabilities["install_receipt"] = "UNVERIFIABLE"
    else:
        capabilities["install_receipt"] = "UNVERIFIABLE"
    return doctor_projection(
        source_identity=source_identity,
        installed_identity=installed_identity,
        capabilities=capabilities,
        diagnostics=include_diagnostics,
    )


def _effect_workspace_root() -> Path:
    """Return the cwd only when v4 may safely bind effects to it."""

    root = Path.cwd()
    if is_legacy_input(root):
        raise EntryError(*unsupported_legacy_error())
    return root


def _interactive_start(args, *, started_roots=None):
    def start_prepared(prepared):
        context = (
            prepared if hasattr(prepared, "manifest") else review_prepared(prepared)
        )
        started_root = _new_loop_root(args.root, context.manifest.loop_ref)
        if started_roots is not None:
            started_roots.append(started_root)
        return _start_with_owned_provider(context, root=args.root)

    value = args.goal_file_or_prepared_directory
    subject = Path(value)
    if value == "-":
        request = read_intake_input(value)
    else:
        maximum = _source_maximum(subject)
        admitted = _admit_source(subject, maximum=maximum)
        if admitted is not None and admitted[0] == "directory":
            if is_legacy_input(
                subject,
                path_kind="directory",
                directory_entries=admitted[1],
            ):
                raise EntryError(*unsupported_legacy_error())
            _effect_workspace_root()
            return start_prepared(subject)
        request = _decode_admitted_input(value, subject, maximum, admitted)
    report = intake_report_loop(request)
    print_intake_report(report)
    disposition = report["1 最终判定"]["disposition"]
    if disposition == "DIRECT_TASK_RECOMMENDED":
        raise EntryError(
            "USER_DIRECT_TASK_RECOMMENDED",
            report["1 最终判定"]["reason"],
            "Run the task directly in Codex; no loop was created.",
        )
    if disposition != "READY_FOR_LOOP":
        raise EntryError(
            "USER_CLARIFICATION_REQUIRED",
            report["1 最终判定"]["reason"],
            "Answer the listed intake questions; no loop was created.",
        )
    output = args.prepared_output or Path(str(args.root) + ".prepared")
    prepared = prepare_loop(request, output, workspace_root=_effect_workspace_root())
    print_boundary(prepared)
    if not sys.stdin.isatty():
        raise EntryError(
            "USER_CONFIRMATION_REQUIRED",
            "The preparation is ready but interactive confirmation is unavailable.",
            f"Review {output}, run loopskill4 confirm on it, then start that prepared directory.",
        )
    answer = input('Type "START THIS LOOP" to confirm the displayed boundary: ')
    if answer != "START THIS LOOP":
        raise EntryError(
            "USER_CONFIRMATION_REQUIRED",
            "The displayed start boundary was not explicitly confirmed.",
            "Review the prepared artifacts and confirm them explicitly.",
        )
    confirmed = confirm_loop(output, confirmed=True)
    return start_prepared(confirmed)


def _close_provider(provider) -> None:
    close = getattr(provider, "close", None)
    if callable(close):
        close()


def _finish_owned_provider_task(
    value,
    provider,
    *,
    root: Path,
    workspace_root: Path,
    synchronize_after_wait: bool = True,
):
    """Finish this process's one created task without a daemon or resend."""

    metrics = getattr(provider, "metrics", None)
    if callable(metrics):
        metrics = metrics()
    if not isinstance(metrics, Mapping):
        return value
    created = metrics.get("task_create_count")
    if created == 0:
        return value
    if created != 1:
        raise EntryError(
            "USER_INTERNAL_ERROR",
            "The Codex task creation boundary was not singular.",
            "Preserve the local state and inspect diagnostics; do not repeat start.",
        )
    waiter = getattr(provider, "wait_for_terminal", None)
    if not callable(waiter):
        raise EntryError(
            "USER_INTERNAL_ERROR",
            "The foreground Codex invocation has no bounded terminal evidence.",
            "Preserve the local state and inspect diagnostics; do not repeat start or resume.",
        )
    try:
        waiter(timeout_seconds=float(getattr(provider, "timeout_seconds", 30_000.0)))
        if synchronize_after_wait:
            return sync_loop(
                root=root,
                host_provider=provider,
                workspace_root=workspace_root,
            )
        return value
    except (HostUnavailable, ValueError) as exc:
        raise EntryError(
            "USER_INTERNAL_ERROR",
            "LoopSkill could not confirm whether the one Codex invocation reached a terminal state. It was not resent.",
            "Preserve UNKNOWN and inspect diagnostics; do not run start or resume.",
        ) from exc


def _provider_from_profile(
    workspace_root: Path,
    *,
    root: Path,
    profile: Mapping[str, object],
    ephemeral: bool,
):
    return CodexExecProvider(
        workspace_root,
        timeout_seconds=float(profile["attempt_timeout_seconds"]),
        model=(None if profile.get("model") is None else str(profile["model"])),
        reasoning_effort=(
            None
            if profile.get("reasoning_effort") is None
            else str(profile["reasoning_effort"])
        ),
        network_access=bool(profile["network_access"]),
        sandbox=str(profile["sandbox"]),
        ephemeral=ephemeral,
        attempt_root=None if ephemeral else root / "attempts",
        budget_override=(
            profile.get("budget_override")
            if isinstance(profile.get("budget_override"), Mapping)
            else None
        ),
    )


def _prepared_profile(prepared) -> tuple[Mapping[str, object], bool]:
    context = prepared if hasattr(prepared, "plan") else review_prepared(prepared)
    profile = context.plan.get("worker_profile")
    if isinstance(profile, Mapping):
        return dict(profile), False
    return {
        "attempt_timeout_seconds": 30_000,
        "local_verification": True,
        "model": None,
        "network_access": False,
        "reasoning_effort": None,
        "sandbox": "workspace-write",
    }, True


def _start_with_owned_provider(prepared, *, root: Path):
    context = prepared if hasattr(prepared, "manifest") else review_prepared(prepared)
    root = _new_loop_root(root, context.manifest.loop_ref)
    workspace_root = _effect_workspace_root()
    profile, ephemeral = _prepared_profile(context)
    provider = _provider_from_profile(
        workspace_root, root=root, profile=profile, ephemeral=ephemeral
    )
    try:
        value = start_loop(
            context,
            root=root,
            host_provider=provider,
            workspace_root=workspace_root,
        )
        value = _finish_owned_provider_task(
            value,
            provider,
            root=root,
            workspace_root=workspace_root,
        )
        if not ephemeral and value.progress in {"Active", "Starting"}:
            return _run_to_blocking(root=root)
        return value
    finally:
        _close_provider(provider)


def _refresh_with_owned_provider(*, root: Path):
    workspace_root = _effect_workspace_root()
    profile = worker_profile(root=root)
    provider = _provider_from_profile(
        workspace_root,
        root=root,
        profile=profile,
        ephemeral=profile.get("model") is None,
    )
    try:
        value = sync_loop(
            root=root,
            host_provider=provider,
            workspace_root=workspace_root,
        )
        return _finish_owned_provider_task(
            value,
            provider,
            root=root,
            workspace_root=workspace_root,
            synchronize_after_wait=False,
        )
    finally:
        _close_provider(provider)


def _run_to_blocking(*, root: Path):
    value = status(root=root)
    for _ in range(384):
        if value.progress not in {"Active", "Starting"}:
            return value
        value = _refresh_with_owned_provider(root=root)
    raise EntryError(
        "RESOURCE_LIMIT_EXCEEDED",
        "The foreground run exceeded the v4.2 bounded transition limit.",
        "Inspect status and budgets before continuing.",
    )


def _interactive_canary(args):
    from loop_architect.v4_entry.canary import CanaryError, run_canary

    def confirm(boundary):
        print("Disposable canary boundary:")
        print(
            json.dumps(
                boundary,
                ensure_ascii=False,
                sort_keys=True,
                separators=(",", ":"),
            )
        )
        if not sys.stdin.isatty():
            return False
        answer = input(
            f'Type "START THIS LOOP" to confirm this {args.goals}-Goal '
            "disposable canary boundary: "
        )
        return answer == "START THIS LOOP"

    try:
        host_codex_home = Path(
            os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))
        ).resolve(strict=True)
        return run_canary(
            args.candidate,
            args.evidence_root,
            candidate_root=args.candidate_root,
            confirmation_callback=confirm,
            goal_count=args.goals,
            integrity_inputs={
                "host_auth": host_codex_home / "auth.json",
                "host_config": host_codex_home / "config.toml",
            },
        )
    except CanaryError as exc:
        if args.diagnostics:
            print(f"Canary gate: {exc.code}", file=sys.stderr)
        raise EntryError(
            "USER_INTERNAL_ERROR",
            "The disposable foreground exec canary did not pass its exact boundary.",
            "Preserve the private evidence root and inspect diagnostics; do not spawn again.",
        ) from exc


def main(argv=None) -> int:
    try:
        args = parser().parse_args(argv)
        if args.action == "intake":
            print_intake_report(intake_report_loop(read_intake_input(args.goal_or_file)))
            return 0
        if args.action == "prepare":
            request = read_intake_input(args.goal_or_file)
            prepared = prepare_loop(
                request,
                args.output,
                workspace_root=_effect_workspace_root(),
            )
            print_boundary(prepared)
            return 0
        if args.action == "confirm":
            prepared = review_prepared(args.prepared_directory)
            print_boundary(prepared)
            if not sys.stdin.isatty():
                raise EntryError(
                    "USER_CONFIRMATION_REQUIRED",
                    "Interactive confirmation is required for this prepared boundary.",
                    "Review the preparation in an interactive session; no start authority was created.",
                )
            answer = input('Type "START THIS LOOP" to confirm the displayed boundary: ')
            if answer != "START THIS LOOP":
                raise EntryError(
                    "USER_CONFIRMATION_REQUIRED",
                    "The displayed start boundary was not explicitly confirmed.",
                    "Review the prepared artifacts and confirm them explicitly.",
                )
            prepared = confirm_loop(args.prepared_directory, confirmed=True)
            print("Confirmation: accepted for the unchanged prepared boundary")
            return 0
        if args.action == "compile":
            prepared = review_prepared(args.prepared_directory)
            print(
                json.dumps(
                    {
                        "boundary_digest": prepared.bundle.boundary_digest,
                        "manifest_digest": prepared.bundle.manifest_digest,
                        "status": "PREPARED_VALID",
                        "host_effects": 0,
                    },
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "doctor":
            print(
                json.dumps(
                    _doctor_view(include_diagnostics=args.diagnostics),
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "canary":
            print(
                json.dumps(
                    _interactive_canary(args),
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "list":
            print(
                json.dumps(
                    {"loops": _discover_loops(args.root)},
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "status" and args.refresh:
            # Refresh is workspace-bound and must reject a legacy v3 cwd before
            # even inspecting a v4 Store.  Plain status remains read-only and
            # intentionally works from a legacy cwd.
            _effect_workspace_root()
        selected_root = None
        if args.action in {
            "status",
            "run",
            "continue",
            "pause",
            "resume",
            "stop",
            "policy",
            "roadmap-revise",
            "steer",
            "approve",
            "budget-extend",
        }:
            selected_root = _selected_loop_root(
                args.root, getattr(args, "loop", None)
            )
        if args.action == "policy":
            print(
                json.dumps(
                    policy_view(root=selected_root),
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "roadmap-revise":
            print(
                json.dumps(
                    revise_goal_plan(
                        tuple(args.objectives),
                        root=selected_root,
                        reason=args.reason,
                    ),
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            return 0
        if args.action == "start":
            started_roots = []
            value = _interactive_start(args, started_roots=started_roots)
            selected_root = started_roots[0] if len(started_roots) == 1 else args.root
        elif args.action == "approve":
            value = satisfy_gate(
                root=selected_root,
                workspace_root=_effect_workspace_root(),
                approval_digest=args.approval_digest,
            )
            if value.progress in {"Active", "Starting"}:
                value = _run_to_blocking(root=selected_root)
        elif args.action == "budget-extend":
            value = extend_budget(
                root=selected_root,
                new_max_host_invocations=args.max_host_invocations,
                new_wall_clock_seconds=args.active_compute_seconds,
                reason=args.reason,
            )
            if value.progress in {"Active", "Starting"}:
                value = _run_to_blocking(root=selected_root)
        elif args.action in {"run", "continue"}:
            value = _run_to_blocking(root=selected_root)
            if args.action == "continue" and value.result == "WAITING_TIME":
                value = satisfy_gate(
                    root=selected_root,
                    workspace_root=_effect_workspace_root(),
                )
                if value.progress in {"Active", "Starting"}:
                    value = _run_to_blocking(root=selected_root)
            elif args.action == "continue" and (
                value.result == "WAITING" or value.progress == "Paused"
            ):
                value = control_loop("resume", root=selected_root)
                value = _run_to_blocking(root=selected_root)
        elif args.action in {"pause", "resume", "stop"}:
            value = control_loop(
                args.action,
                root=selected_root,
                reason=getattr(args, "reason", "User requested lifecycle control."),
            )
        elif args.action == "steer":
            value = steer_loop(
                args.choice,
                root=selected_root,
                failure_fingerprint=args.failure_fingerprint,
            )
        else:
            value = (
                _refresh_with_owned_provider(root=selected_root)
                if args.refresh
                else status(root=selected_root)
            )
        print_status(value)
        if getattr(args, "diagnostics", False):
            print(
                "Diagnostics: "
                + json.dumps(
                    diagnostics(root=selected_root),
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
        return 0
    except EntryError as exc:
        print(f"LoopSkill 4 error [{exc.code}]: {exc.message}", file=sys.stderr)
        print(f"Next action: {exc.next_action}", file=sys.stderr)
        return 2
    except Exception:
        print(
            "LoopSkill 4 error [USER_INTERNAL_ERROR]: LoopSkill could not safely complete the action.",
            file=sys.stderr,
        )
        print(
            "Next action: Preserve the current state and use status/readback or diagnostics; do not repeat start blindly.",
            file=sys.stderr,
        )
        return 70


if __name__ == "__main__":
    raise SystemExit(main())
